# Application
APP_NAME=go-skeleton
APP_PORT=8020
APP_ENV=local
APP_DEBUG=true

# Database — aligned with docker-compose defaults
DB_HOST=db
DB_PORT=3306
DB_DATABASE=go_skeleton
DB_USERNAME=root
DB_PASSWORD=

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=bananinha123
REDIS_DB=0

# JWT Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRE_HOUR=24

# Mail (SMTP — use an app-specific password, not your account password)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@example.com

# Observability — set OTEL_ENABLED=true to send traces to Jaeger
OTEL_ENABLED=false
OTEL_SERVICE_NAME=go-skeleton
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

# Docs (Laravel) — port exposed by the docs-laravel container
DOCS_PORT=8080

# Image versions — pinned for reproducible builds
MYSQL_VERSION=8.0
REDIS_VERSION=7-alpine
JAEGER_VERSION=1.56
OTEL_COLLECTOR_VERSION=0.98.0

# Jaeger ports — UI and HTTP collector
JAEGER_UI_PORT=16686
JAEGER_COLLECTOR_PORT=14268
